# Backend Configuration

# Server Port
PORT=5000

# MongoDB Atlas Connection String
# Format: mongodb+srv://username:password@cluster-name.mongodb.net/database-name?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/interviewprep?retryWrites=true&w=majority

# OpenRouter API Key
# Get from: https://openrouter.ai
OPENROUTER_API_KEY=your_api_key_here

# Environment
NODE_ENV=development

# JWT Secret for authentication (optional, for future auth implementation)
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000
